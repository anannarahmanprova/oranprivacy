

ARG ONOS_BUILD_VERSION=undefined

FROM onosproject/golang-build:v1.3.0 as build

ENV GO111MODULE=on
ARG ONOS_MAKE_TARGET=build

# --- Install SGX and system dependencies ---
RUN apt-get update && apt-get install -y \
    build-essential \
    gcc \
    g++ \
    make \
    wget \
    curl \
    python3 \
    python3-pip \
    libssl-dev \
    libcurl4-openssl-dev \
    ocaml \
    autoconf \
    libtool \
    pkg-config \
    git \
    ca-certificates

# --- Set SGX environment variables ---
ENV SGX_SDK=/opt/intel/sgxsdk/sgxsdk
ENV SGX_MODE=SIM
ENV SGX_ARCH=x64

COPY sgxsdk $SGX_SDK
ENV PATH="$SGX_SDK/bin/x64:$PATH"
ENV LD_LIBRARY_PATH="$SGX_SDK/lib64:$LD_LIBRARY_PATH"

ENV CGO_CFLAGS="-Wl,--allow-multiple-definition -Wno-error -I$SGX_SDK/include  -I$SGX_SDK/include/tlibc"
ENV CGO_LDFLAGS=" -lbridge -L/opt/intel/sgxsdk/sgxsdk/lib64 \
-lsgx_trts_sim \
-lsgx_tservice_sim \
-lsgx_tcrypto \
-lsgx_tcxx \
-lsgx_tstdc \
-lc \
-Wl,--no-undefined \
-Wl,--defsym,__ImageBase=0 \
-Wl,--allow-multiple-definition \
-Wl,--whole-archive -lsgx_trts_sim -Wl,--no-whole-archive \
-Wl,-pie,-eenclave_entry -Wl,--export-dynamic -Wl,-z,notext"


# --- Copy SGX SDK ---


# --- Set up ONOS KPIMON xApp ---

COPY Makefile go.mod go.sum /go/src/github.com/onosproject/onos-kpimon/
COPY cmd/ /go/src/github.com/onosproject/onos-kpimon/cmd/
COPY pkg/ /go/src/github.com/onosproject/onos-kpimon/pkg/
COPY vendor/ /go/src/github.com/onosproject/onos-kpimon/vendor/
COPY api/ /go/src/github.com/onosproject/onos-kpimon/api
COPY build/ /go/src/github.com/onosproject/onos-kpimon/build/

WORKDIR /go/src/github.com/onosproject/onos-kpimon/pkg/monitoring

RUN make
# Build the ONOS KPIMON xApp

RUN cd /go/src/github.com/onosproject/onos-kpimon && GOFLAGS=-mod=vendor make ${ONOS_MAKE_TARGET}


# --- Build SGX part ---


# --- Build your SGX Go app ---


# ---------------- Stage 2: Runtime image ----------------
FROM frolvlad/alpine-glibc:alpine-3.12

# Non-root user
USER nobody

# Copy built binaries
COPY --from=build /go/src/github.com/onosproject/onos-kpimon/build/_output/onos-kpimon /usr/local/bin/onos-kpimon


# Optional: copy SGX simulation libraries if needed
COPY --from=build /opt/intel/sgxsdk/sgxsdk/lib64 /opt/intel/sgxsdk/lib64
ENV LD_LIBRARY_PATH=/opt/intel/sgxsdk/lib64

# Expose ports
EXPOSE 19999
EXPOSE 5150


# Start both apps (you can customize this)
CMD ["onos-kpimon"]




